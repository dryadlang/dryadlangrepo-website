---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ShortcutsModal from '../components/ShortcutsModal.tsx';
import '../index.css';

export interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="pt">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | Dryad</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="min-h-screen flex flex-col bg-white text-gray-900 font-sans">
    <Header />
    <main class="w-full max-w-3xl mx-auto px-4 py-10 md:py-14">
      <slot />
    </main>
    <Footer />
    <ShortcutsModal client:load />
  </body>
</html>

<script>
// Global keyboard shortcuts: g+h → home, g+d → docs, g+b → blog
let lastKey: string | null = null;
let timeoutId: ReturnType<typeof setTimeout> | null = null;

document.addEventListener("keydown", (e: KeyboardEvent) => {
  const tag = (e.target as HTMLElement).tagName;
  if (tag === "INPUT" || tag === "TEXTAREA" || (e.target as HTMLElement).isContentEditable) {
    lastKey = null;
    return;
  }

  const key = e.key.toLowerCase();

  if (lastKey === "g") {
    if (key === "h") {
      window.location.href = "/";
    } else if (key === "d") {
      window.location.href = "/docs/introducao-e-filosofia";
    } else if (key === "b") {
      window.location.href = "/blog";
    }
    lastKey = null;
  } else if (key === "g") {
    lastKey = "g";
    if (timeoutId) clearTimeout(timeoutId);
    timeoutId = setTimeout(() => { lastKey = null; }, 1000);
  } else {
    lastKey = null;
  }
});
</script>
