---
import CodeCopyButton from './CodeCopyButton.tsx';
import type { DocSection } from '../types';

export interface Props {
  section: DocSection;
}

const { section } = Astro.props;

function renderInlineCode(cell: string): string {
  return cell.split("`").map((part, pIdx) => {
    if (pIdx % 2 === 1) {
      return `<code class="text-emerald-800 font-semibold">${part}</code>`;
    }
    return part;
  }).join("");
}

function renderHighlightedCode(code: string): string {
  return code.split("\n").map((line, idx) => {
    let content = line;
    let commentPart = "";
    const commentIdx = line.indexOf("//");
    if (commentIdx !== -1) {
      content = line.substring(0, commentIdx);
      commentPart = line.substring(commentIdx);
    }

    const rawHtml = content.replace(
      /(\b(?:let|const|function|fn|class|extends|constructor|super|this|static|public|private|protected|import|export|match|thread|mutex|try|catch|finally|throw|return|async|await)\b)|(\b(?:number|string|bool|null|any|void|extern)\b)|(\b(?:true|false)\b)|(#[a-zA-Z_]+)|(::)|([0-9]+\.?[0-9]*|0x[0-9A-Fa-f]+|0b[01]+|0o[0-7]+)/g,
      (match, keyword, typeKw, boolVal, nativeDir, namespace, number) => {
        if (keyword) return `<span class="text-emerald-400 font-bold">${match}</span>`;
        if (typeKw)  return `<span class="text-teal-400 font-semibold">${match}</span>`;
        if (boolVal) return `<span class="text-amber-400 font-bold">${match}</span>`;
        if (nativeDir) return `<span class="text-emerald-400 font-semibold">${match}</span>`;
        if (namespace) return `<span class="text-orange-400 font-bold">${match}</span>`;
        if (number) return `<span class="text-blue-400 font-medium">${match}</span>`;
        return match;
      }
    );

    const lineNum = `<span class="text-gray-600 select-none">${String(idx + 1).padStart(2)}</span> `;
    const codeHtml = rawHtml + (commentPart ? `<span class="text-gray-500 italic">${commentPart}</span>` : "");
    return `${lineNum}${codeHtml}`;
  }).join("\n");
}
---

<article class="leading-relaxed">

  <h1 class="text-2xl md:text-3xl font-extrabold text-gray-900 mb-5 tracking-tight leading-tight">{section.title}</h1>

  <p class="text-[15px] md:text-base text-gray-600 mb-9 leading-relaxed max-w-[62ch]">{section.content}</p>

  {section.tableData && (
    <div class="mb-10 overflow-x-auto">
      <table class="data-table">
        <thead>
          <tr>
            {section.tableData.headers.map((hdr) => (
              <th>{hdr}</th>
            ))}
          </tr>
        </thead>
        <tbody>
          {section.tableData.rows.map((row, ri) => (
            <tr>
              {row.map((cell) => (
                <td set:html={renderInlineCode(cell)} />
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )}

  {section.codeSnippets && section.codeSnippets.length > 0 && (
    <div class="flex flex-col gap-7 mt-2 mb-10">
      {section.codeSnippets.map((snippet, idx) => {
        const lines = renderHighlightedCode(snippet.code);
        return (
          <div>
            <div class="flex items-center justify-between mb-1.5">
              <span class="eyebrow text-[#0f6b4f]">{snippet.title}</span>
              <CodeCopyButton code={snippet.code} index={idx} client:load />
            </div>
            <pre class="code-block" set:html={lines}></pre>
            {snippet.description && (
              <p class="text-[13px] text-gray-500 mt-2 italic leading-relaxed">{snippet.description}</p>
            )}
          </div>
        );
      })}
    </div>
  )}

  <p class="text-xs text-gray-400 mt-12 pt-6 border-t border-gray-100 leading-relaxed">
    Found an error in the spec? Open a PR.
    <br />
    Official Version: 1.0 · May 2026
  </p>

</article>
