---
import CodeCopyButton from './CodeCopyButton.tsx';
import type { DocSection } from '../types';

export interface Props {
  section: DocSection;
}

const { section } = Astro.props;

function renderInlineCode(cell: string): string {
  return cell.split("`").map((part, pIdx) => {
    if (pIdx % 2 === 1) {
      return `<code class="text-emerald-800 font-semibold">${part}</code>`;
    }
    return part;
  }).join("");
}

function renderHighlightedCode(code: string): string {
  return code.split("\n").map((line, idx) => {
    let content = line;
    let commentPart = "";
    const commentIdx = line.indexOf("//");
    if (commentIdx !== -1) {
      content = line.substring(0, commentIdx);
      commentPart = line.substring(commentIdx);
    }

    const rawHtml = content
      .replace(/\b(let|const|function|fn|class|extends|constructor|super|this|static|public|private|protected|import|export|match|thread|mutex|try|catch|finally|throw|return|async|await)\b/g, '<span class="text-emerald-400 font-bold">$1</span>')
      .replace(/\b(number|string|bool|null|any|void|extern)\b/g, '<span class="text-teal-400 font-semibold">$1</span>')
      .replace(/\b(true|false)\b/g, '<span class="text-amber-400 font-bold">$1</span>')
      .replace(/([0-9]+\.?[0-9]*|0x[0-9A-Fa-f]+|0b[01]+|0o[0-7]+)/g, '<span class="text-blue-400 font-medium">$1</span>')
      .replace(/(#[a-zA-Z_]+)/g, '<span class="text-emerald-400 font-semibold">$1</span>')
      .replace(/(::)/g, '<span class="text-orange-400 font-bold">$1</span>');

    const lineNum = `<span class="text-gray-600 select-none">${String(idx + 1).padStart(2)}</span> `;
    const codeHtml = rawHtml + (commentPart ? `<span class="text-gray-500 italic">${commentPart}</span>` : "");
    return `${lineNum}${codeHtml}`;
  }).join("\n");
}
---

<article class="py-2 leading-relaxed">

  <h2 class="text-lg font-bold text-gray-900 mb-4 leading-tight">{section.title}</h2>

  <p class="text-sm text-gray-600 mb-6 leading-relaxed">{section.content}</p>

  {section.tableData && (
    <div class="mb-8 overflow-x-auto">
      <table class="w-full text-left text-sm border-collapse">
        <thead>
          <tr class="text-gray-500 text-xs border-b border-gray-200">
            {section.tableData.headers.map((hdr) => (
              <th class="py-1.5 pr-3 font-semibold">{hdr}</th>
            ))}
          </tr>
        </thead>
        <tbody>
          {section.tableData.rows.map((row, ri) => (
            <tr class="border-b border-gray-100">
              {row.map((cell) => (
                <td class="py-1.5 pr-3 text-gray-700 leading-relaxed" set:html={renderInlineCode(cell)} />
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )}

  {section.codeSnippets && section.codeSnippets.length > 0 && (
    <div class="flex flex-col gap-5 mt-4 mb-8">
      {section.codeSnippets.map((snippet, idx) => {
        const lines = renderHighlightedCode(snippet.code);
        return (
          <div>
            <div class="flex items-center justify-between mb-1">
              <span class="text-xs text-emerald-800 font-semibold">{snippet.title}</span>
              <CodeCopyButton code={snippet.code} index={idx} client:load />
            </div>
            <pre class="bg-gray-900 text-gray-100 p-4 text-sm leading-snug overflow-x-auto font-mono select-text" set:html={lines}></pre>
            {snippet.description && (
              <p class="text-xs text-gray-500 mt-1 italic leading-relaxed">{snippet.description}</p>
            )}
          </div>
        );
      })}
    </div>
  )}

  <p class="text-xs text-gray-400 mt-10 leading-relaxed">
    Encontrou algum erro na especificação? Abra uma PR.
    <br />
    Versão Oficial: 1.0 · May 2026
  </p>

</article>
