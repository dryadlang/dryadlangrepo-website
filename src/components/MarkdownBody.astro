---
// Renders pre-built HTML from markdown with the site's typography.
export interface Props {
  html: string;
}
const { html } = Astro.props;
---

<div class="md-body" set:html={html} />

<style is:global>
  .md-body { font-size: 15px; color: #374151; line-height: 1.7; }
  .md-body > :first-child { margin-top: 0; }
  .md-body h1 { display: none; }
  .md-body h2 { font-size: 1.3rem; font-weight: 800; color: #111827; letter-spacing: -0.01em; margin: 2.2em 0 0.6em; scroll-margin-top: 5rem; }
  .md-body h3 { font-size: 1.05rem; font-weight: 700; color: #111827; margin: 1.6em 0 0.5em; scroll-margin-top: 5rem; }
  .md-body h4 { font-size: 0.95rem; font-weight: 700; color: #111827; margin: 1.3em 0 0.4em; }
  .md-body .anchor { float: left; margin-left: -1.1em; width: 1.1em; color: #d1d5db; text-decoration: none; opacity: 0; }
  .md-body h2:hover .anchor, .md-body h3:hover .anchor { opacity: 1; }
  .md-body p { margin: 0 0 0.85em; }
  .md-body a { color: #0f6b4f; }
  .md-body ul, .md-body ol { padding-left: 1.4em; margin: 0.4em 0 1em; }
  .md-body ul { list-style: disc; }
  .md-body ol { list-style: decimal; }
  .md-body li { margin-bottom: 0.3em; }
  .md-body blockquote { border-left: 3px solid #0f6b4f; padding: 0.2em 0 0.2em 1em; color: #4b5563; margin: 1em 0; }
  .md-body code { font-family: "JetBrains Mono", "Fira Code", Consolas, monospace; font-size: 0.82em; background: #f1f5f9; padding: 0.1em 0.3em; }
  .md-body pre {
    font-family: "JetBrains Mono", "Fira Code", Consolas, monospace; font-size: 0.8125rem; line-height: 1.6;
    background: #13161a; color: #e5e7eb; border-left: 3px solid #0f6b4f; padding: 1rem 1.125rem;
    overflow-x: auto; margin: 1em 0 1.3em;
  }
  .md-body pre code { background: none; padding: 0; font-size: inherit; color: inherit; }
  .md-body table { display: block; overflow-x: auto; width: 100%; border-collapse: collapse; font-size: 13.5px; margin: 1em 0 1.5em; }
  .md-body th { text-align: left; padding: 0.45rem 1rem 0.45rem 0; font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; color: #6b7280; border-bottom: 2px solid #111827; }
  .md-body td { padding: 0.5rem 1rem 0.5rem 0; vertical-align: top; border-bottom: 1px solid #e5e7eb; }
  .md-body hr { border: none; border-top: 1px solid #e5e7eb; margin: 2em 0; }
</style>
