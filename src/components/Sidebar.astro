---
import type { DocSection } from '../types';
import { docsData } from '../data/docsData';

export interface Props {
  selectedDocId: string;
}

const { selectedDocId } = Astro.props;

// Group documentation sections by their corresponding categories
const categories = docsData.reduce((acc: Record<string, DocSection[]>, doc) => {
  if (!acc[doc.category]) {
    acc[doc.category] = [];
  }
  acc[doc.category].push(doc);
  return acc;
}, {} as Record<string, DocSection[]>);
---

<nav class="mb-8 text-sm leading-relaxed">
  {Object.entries(categories).map(([category, sections]) => (
    <div class="mb-3">
      <span class="text-gray-500 font-semibold text-xs">{category}:</span>{' '}
      {sections.map((section, i) => (
        <span>
          {i > 0 && <span class="text-gray-300 mx-0.5">·</span>}
          {section.id === selectedDocId ? (
            <span class="text-gray-900 font-semibold">{section.title.replace(/^\d+(\.\d+)?\s+/, "")}</span>
          ) : (
            <a href={`/docs/${section.id}`} class="text-gray-600 no-underline hover:text-emerald-800 hover:underline">
              {section.title.replace(/^\d+(\.\d+)?\s+/, "")}
            </a>
          )}
        </span>
      ))}
    </div>
  ))}
</nav>
