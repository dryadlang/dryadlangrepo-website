---
import SearchWidget from './SearchWidget.tsx';
---

<header class="w-full sticky top-0 z-40 bg-white/90 backdrop-blur-sm border-b border-gray-100">
  <div class="max-w-5xl mx-auto px-5 md:px-8 h-16 flex items-center justify-between gap-4">
    <div class="flex items-center gap-8">
      <a href="/" class="flex items-center gap-2 text-[15px] font-extrabold tracking-tight text-gray-900 no-underline hover:text-[#0f6b4f]">
        <img src="/favicon.svg" alt="" class="w-5 h-5" />
        DRYADlang
      </a>
      <nav id="primary-nav" class="hidden sm:flex items-center gap-7 text-[13px] font-semibold text-gray-500">
        <a href="/docs" data-nav="docs" class="no-underline hover:text-[#0f6b4f] transition-colors py-1">Docs</a>
        <a href="/stdlib" data-nav="stdlib" class="no-underline hover:text-[#0f6b4f] transition-colors py-1">Stdlib</a>
        <a href="/conventions" data-nav="conventions" class="no-underline hover:text-[#0f6b4f] transition-colors py-1">Conventions</a>
        <a href="/blog" data-nav="blog" class="no-underline hover:text-[#0f6b4f] transition-colors py-1">Blog</a>
        <a href="/coverage" data-nav="coverage" class="no-underline hover:text-[#0f6b4f] transition-colors py-1">Coverage</a>
      </nav>
    </div>

    <div class="flex items-center gap-3">
      <SearchWidget client:load />
      <button
        id="mobile-nav-toggle"
        type="button"
        aria-expanded="false"
        aria-label="Toggle navigation menu"
        class="sm:hidden flex flex-col justify-center gap-[5px] w-8 h-8 -mr-1 cursor-pointer"
      >
        <span class="block h-px w-5 bg-gray-700"></span>
        <span class="block h-px w-5 bg-gray-700"></span>
        <span class="block h-px w-5 bg-gray-700"></span>
      </button>
    </div>
  </div>

  <nav id="mobile-nav" class="hidden sm:hidden flex-col text-sm font-semibold text-gray-600 border-t border-gray-100 px-5 py-3 gap-1">
    <a href="/docs" data-nav="docs" class="no-underline hover:text-[#0f6b4f] py-2">Docs</a>
    <a href="/stdlib" data-nav="stdlib" class="no-underline hover:text-[#0f6b4f] py-2">Stdlib</a>
    <a href="/conventions" data-nav="conventions" class="no-underline hover:text-[#0f6b4f] py-2">Conventions</a>
    <a href="/blog" data-nav="blog" class="no-underline hover:text-[#0f6b4f] py-2">Blog</a>
    <a href="/coverage" data-nav="coverage" class="no-underline hover:text-[#0f6b4f] py-2">Coverage</a>
  </nav>
</header>

<script>
  // Mark the current section in the header nav and wire up the mobile toggle.
  function markActiveNav() {
    const path = window.location.pathname;
    const section = path.startsWith('/docs')
      ? 'docs'
      : path.startsWith('/stdlib')
      ? 'stdlib'
      : path.startsWith('/conventions')
      ? 'conventions'
      : path.startsWith('/blog')
      ? 'blog'
      : path.startsWith('/coverage')
      ? 'coverage'
      : '';
    document.querySelectorAll<HTMLAnchorElement>('[data-nav]').forEach((el) => {
      const isCurrent = el.dataset.nav === section;
      el.classList.toggle('is-current', isCurrent);
      el.classList.toggle('text-gray-500', !isCurrent);
    });
  }
  markActiveNav();

  const toggle = document.getElementById('mobile-nav-toggle');
  const mobileNav = document.getElementById('mobile-nav');
  toggle?.addEventListener('click', () => {
    const isOpen = mobileNav?.classList.toggle('flex');
    mobileNav?.classList.toggle('hidden');
    toggle.setAttribute('aria-expanded', String(!!isOpen));
  });
</script>
