---
import BaseLayout from "../layouts/BaseLayout.astro";
import rawCoverage from "../data/coverage.json";
import type { CoverageSnapshot, StdlibApi, StdlibModule } from "../data/coverageTypes";

const coverage = rawCoverage as unknown as CoverageSnapshot;
const lines = coverage.lineCoverage;
const stdlib = coverage.stdlib;
const s = stdlib.summary;

const percent = (part: number, whole: number) => (whole ? Math.round((1000 * part) / whole) / 10 : 100);
const docPct = percent(s.documented, s.publicApis);
const testPct = percent(s.tested, s.publicApis);

function tone(value: number, target = 80, floor = 70): string {
  if (value >= target) return "good";
  if (value >= floor) return "fair";
  return "poor";
}

function apiStatus(api: { tested: boolean; documented: boolean }): string {
  if (api.tested && api.documented) return "good";
  if (api.tested || api.documented) return "fair";
  return "poor";
}

const packages = stdlib.modules.reduce((acc: Record<string, StdlibModule[]>, module) => {
  const pkg = module.module.split("/").slice(0, 2).join("/");
  (acc[pkg] ??= []).push(module);
  return acc;
}, {});

function publicApis(module: StdlibModule): StdlibApi[] {
  return module.apis.filter((api) => !api.internal && !api.deprecated);
}

function packageStats(modules: StdlibModule[]) {
  const apis = modules.flatMap(publicApis);
  return {
    total: apis.length,
    documented: apis.filter((a) => a.documented).length,
    tested: apis.filter((a) => a.tested).length,
  };
}

const gapsByKind = {
  "low-coverage": coverage.gaps.filter((g) => g.kind === "low-coverage"),
  undocumented: coverage.gaps.filter((g) => g.kind === "undocumented"),
  untested: coverage.gaps.filter((g) => g.kind === "untested"),
};

const generated = new Date(coverage.generatedAt).toISOString().slice(0, 10);
const repo = "https://github.com/dryadlang/source/blob/main/";
---

<BaseLayout
  title="Coverage map"
  description="Where Dryad is and where it must go: runtime test coverage, the @std API surface, and execution-tier support."
  wide
>
  <div class="coverage">
    <h1 class="text-2xl md:text-3xl font-extrabold text-gray-900 mb-2 tracking-tight">Coverage map</h1>
    <p class="text-[15px] text-gray-600 mb-2 leading-relaxed max-w-[68ch]">
      Where Dryad is and where it must go. Runtime test coverage comes from the CI coverage build;
      the standard library map lists every public API and whether tests and docs cover it.
    </p>
    <p class="text-[12px] text-gray-400 mb-10">
      Snapshot {generated}{lines?.commit && <> · source <code>{lines.commit}</code></>} · generated by
      <a href={`${repo}scripts/coverage_map.py`}><code>scripts/coverage_map.py</code></a>
    </p>

    <!-- ───────── Summary ───────── -->
    <section class="mb-14">
      <p class="eyebrow mb-4">At a glance</p>
      <div class="grid grid-cols-2 md:grid-cols-5 gap-x-8 gap-y-6">
        {lines && (
          <>
            <div class="metric">
              <span class={`metric-value ${tone(lines.line, lines.target, lines.floor)}`}>{lines.line}%</span>
              <span class="metric-label">runtime lines</span>
              <span class="metric-note">target {lines.target}%, CI floor {lines.floor}%</span>
            </div>
            <div class="metric">
              <span class={`metric-value ${tone(lines.function)}`}>{lines.function}%</span>
              <span class="metric-label">runtime functions</span>
            </div>
            <div class="metric">
              <span class={`metric-value ${tone(lines.branch)}`}>{lines.branch}%</span>
              <span class="metric-label">runtime branches</span>
            </div>
          </>
        )}
        <div class="metric">
          <span class={`metric-value ${tone(docPct)}`}>{docPct}%</span>
          <span class="metric-label">@std APIs documented</span>
          <span class="metric-note">{s.documented} of {s.publicApis}</span>
        </div>
        <div class="metric">
          <span class={`metric-value ${tone(testPct)}`}>{testPct}%</span>
          <span class="metric-label">@std APIs tested</span>
          <span class="metric-note">{s.tested} of {s.publicApis}</span>
        </div>
      </div>
    </section>

    <!-- ───────── Runtime ───────── -->
    {lines && (
      <section class="mb-14">
        <p class="eyebrow mb-1">Runtime test coverage</p>
        <p class="text-[13px] text-gray-500 mb-4">
          {lines.linesCovered.toLocaleString("en")} of {lines.linesTotal.toLocaleString("en")} C++ lines run by the
          test suite. Open a module to see its files, worst first.
        </p>
        <div class="flex flex-col">
          {lines.modules.map((module) => (
            <details class="row-details">
              <summary class="cov-row">
                <span class="cov-name">{module.name}</span>
                <span class="cov-bar"><span class={`cov-fill ${tone(module.line, lines.target, lines.floor)}`} style={`width:${module.line}%`}></span>
                  <span class="cov-mark" style={`left:${lines.target}%`}></span></span>
                <span class="cov-num">{module.line}%</span>
                <span class="cov-meta">{module.lines.toLocaleString("en")} lines · fn {module.function}% · br {module.branch}%</span>
              </summary>
              <table class="data-table mt-2 mb-4">
                <thead><tr><th>File</th><th>Lines</th><th>Line</th><th>Function</th><th>Branch</th></tr></thead>
                <tbody>
                  {module.files.map((file) => (
                    <tr>
                      <td><a href={`${repo}src/${file.file}`}><code>{file.file}</code></a></td>
                      <td>{file.lines}</td>
                      <td class={`num ${tone(file.line, lines.target, lines.floor)}`}>{file.line}%</td>
                      <td class="num">{file.function}%</td>
                      <td class="num">{file.branch}%</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </details>
          ))}
        </div>
      </section>
    )}

    <!-- ───────── Stdlib ───────── -->
    <section class="mb-14">
      <p class="eyebrow mb-1">Standard library</p>
      <p class="text-[13px] text-gray-500 mb-2 max-w-[70ch]">
        {s.publicApis} public APIs and {s.methods} public methods across {s.modules} modules. A name counts as
        tested when a test references it, and as documented when its module page mentions it.
        {s.internalHelpers} internal helpers{s.deprecatedAliases ? <> and {s.deprecatedAliases} deprecated aliases</> : ""} are left out.
      </p>
      <p class="legend mb-5">
        <span class="chip good">tested + documented</span>
        <span class="chip fair">one of the two</span>
        <span class="chip poor">neither</span>
      </p>
      <div class="flex flex-col">
        {Object.entries(packages).map(([pkg, modules]) => {
          const stats = packageStats(modules);
          return (
            <details class="row-details">
              <summary class="cov-row">
                <span class="cov-name"><code>{pkg}</code></span>
                <span class="cov-bar">
                  <span class={`cov-fill ${tone(percent(stats.documented, stats.total))}`} style={`width:${percent(stats.documented, stats.total)}%`}></span>
                </span>
                <span class="cov-num">{percent(stats.documented, stats.total)}%</span>
                <span class="cov-meta">{stats.total} APIs · {stats.documented} documented · {stats.tested} tested</span>
              </summary>
              <div class="pl-1 pb-4">
                {modules.map((module) => {
                  const apis = publicApis(module);
                  return (
                    <div class="mt-4">
                      <p class="text-[13px] font-semibold text-gray-800">
                        <a href={`${repo}${module.source}`}><code>{module.module}</code></a>
                        {module.docPage
                          ? <a class="ml-2 text-[12px] font-normal" href={`https://github.com/dryadlang/docs/blob/main/stdlib/${module.docPage}`}>docs/stdlib/{module.docPage}</a>
                          : <span class="ml-2 text-[12px] font-normal text-red-700">no doc page</span>}
                      </p>
                      {apis.length === 0
                        ? <p class="text-[12px] text-gray-400 mt-1">Re-export or implementation module; no public names of its own.</p>
                        : (
                          <div class="flex flex-wrap gap-1.5 mt-2">
                            {apis.map((api) => (
                              <span class={`chip ${apiStatus(api)}`} title={`${api.kind}: ${api.tested ? "tested" : "not tested"}, ${api.documented ? "documented" : "not documented"}`}>
                                {api.name}{api.kind === "class" && api.methods && api.methods.length > 0 && (
                                  <span class="chip-count">{api.methods.filter((m) => m.documented).length}/{api.methods.length}</span>
                                )}
                              </span>
                            ))}
                          </div>
                        )}
                    </div>
                  );
                })}
              </div>
            </details>
          );
        })}
      </div>
      <p class="text-[12px] text-gray-400 mt-3">Class chips show documented / total public methods.</p>
    </section>

    <!-- ───────── Tiers ───────── -->
    <section class="mb-14">
      <p class="eyebrow mb-1">Execution tiers</p>
      <p class="text-[13px] text-gray-500 mb-4">
        Language constructs on the interpreter and the bytecode VM. Source:
        <a href={`https://github.com/dryadlang/docs/blob/main/${coverage.tiers.source.replace(/^docs\//, "")}`}><code>BYTECODE_COVERAGE.md</code></a>.
      </p>
      <table class="data-table">
        <thead><tr><th>Construct</th><th>Interpreter</th><th>Bytecode</th><th>Notes</th></tr></thead>
        <tbody>
          {coverage.tiers.constructs.map((row) => (
            <tr><td>{row.construct}</td><td>{row.interpreter}</td><td>{row.bytecode}</td><td class="text-gray-500">{row.notes}</td></tr>
          ))}
        </tbody>
      </table>
      {coverage.tiers.interpreterOnly.length > 0 && (
        <>
          <p class="text-[13px] font-semibold text-gray-800 mt-8 mb-2">Interpreter-only today</p>
          <table class="data-table">
            <thead><tr><th>Construct</th><th>Reason</th></tr></thead>
            <tbody>
              {coverage.tiers.interpreterOnly.map((row) => (
                <tr><td>{row.construct}</td><td class="text-gray-500">{row.reason}</td></tr>
              ))}
            </tbody>
          </table>
        </>
      )}
    </section>

    <!-- ───────── Gaps ───────── -->
    <section class="mb-6">
      <p class="eyebrow mb-1">Where we must go</p>
      <p class="text-[13px] text-gray-500 mb-4">Generated work list. Each item disappears from the next snapshot once it is covered.</p>
      <div class="grid md:grid-cols-3 gap-x-10 gap-y-8">
        <div>
          <p class="text-[13px] font-semibold text-gray-800 mb-2">Runtime files under the CI floor ({gapsByKind["low-coverage"].length})</p>
          <ul class="gap-list">
            {gapsByKind["low-coverage"].map((g) => <li><code>{g.item}</code> <span>{g.detail}</span></li>)}
          </ul>
        </div>
        <div>
          <p class="text-[13px] font-semibold text-gray-800 mb-2">Undocumented @std APIs ({gapsByKind.undocumented.length})</p>
          <ul class="gap-list">
            {gapsByKind.undocumented.map((g) => <li><code>{g.item.replace("@std/", "")}</code></li>)}
          </ul>
        </div>
        <div>
          <p class="text-[13px] font-semibold text-gray-800 mb-2">Untested @std APIs ({gapsByKind.untested.length})</p>
          <ul class="gap-list">
            {gapsByKind.untested.map((g) => <li><code>{g.item.replace("@std/", "")}</code></li>)}
          </ul>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .metric { display: flex; flex-direction: column; gap: 0.125rem; }
  .metric-value { font-size: 1.75rem; font-weight: 800; letter-spacing: -0.02em; line-height: 1.1; }
  .metric-label { font-size: 12px; font-weight: 600; color: #374151; }
  .metric-note { font-size: 11px; color: #9ca3af; }
  .good { color: #0f6b4f; }
  .fair { color: #a16207; }
  .poor { color: #b91c1c; }

  .row-details { border-bottom: 1px solid #f3f4f6; }
  .row-details > summary { list-style: none; cursor: pointer; }
  .row-details > summary::-webkit-details-marker { display: none; }
  .cov-row {
    display: grid;
    grid-template-columns: minmax(7rem, 11rem) 1fr 3.5rem;
    align-items: center;
    gap: 0.75rem 1rem;
    padding: 0.6rem 0;
  }
  .cov-row:hover .cov-name { color: #0f6b4f; }
  .cov-name { font-size: 14px; font-weight: 600; color: #111827; }
  .cov-name::before { content: "▸"; display: inline-block; width: 1rem; color: #9ca3af; transition: transform 0.15s; }
  details[open] > summary .cov-name::before { transform: rotate(90deg); }
  .cov-bar { position: relative; height: 6px; background: #f3f4f6; }
  .cov-fill { position: absolute; inset: 0 auto 0 0; }
  .cov-fill.good { background: #0f6b4f; }
  .cov-fill.fair { background: #ca8a04; }
  .cov-fill.poor { background: #dc2626; }
  .cov-mark { position: absolute; top: -3px; bottom: -3px; width: 1px; background: #111827; }
  .cov-num { font-size: 13px; font-weight: 700; text-align: right; font-variant-numeric: tabular-nums; }
  .cov-meta { grid-column: 2 / 4; font-size: 11.5px; color: #9ca3af; margin-top: -0.4rem; }
  .num { font-variant-numeric: tabular-nums; }

  .chip {
    display: inline-flex; align-items: center; gap: 0.3rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 11.5px;
    padding: 0.1rem 0.45rem; border: 1px solid currentColor; border-radius: 2px;
  }
  .chip.good { color: #0f6b4f; background: #f0fdf4; }
  .chip.fair { color: #a16207; background: #fefce8; }
  .chip.poor { color: #b91c1c; background: #fef2f2; }
  .chip-count { font-size: 10px; opacity: 0.75; }
  .legend { display: flex; gap: 0.5rem; flex-wrap: wrap; }

  .gap-list { font-size: 12px; max-height: 24rem; overflow-y: auto; }
  .gap-list li { padding: 0.2rem 0; border-bottom: 1px solid #f3f4f6; color: #374151; }
  .gap-list li span { color: #9ca3af; margin-left: 0.25rem; }
</style>
