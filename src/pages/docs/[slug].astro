---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sidebar from '../../components/Sidebar.astro';
import DocContent from '../../components/DocContent.astro';
import { docsData } from '../../data/docsData';

export async function getStaticPaths() {
  return docsData.map((doc) => ({
    params: { slug: doc.id },
    props: { doc },
  }));
}

const { doc } = Astro.props;

// Find current index for prev/next navigation
const currentIndex = docsData.findIndex((d) => d.id === doc.id);
const prevDoc = currentIndex > 0 ? docsData[currentIndex - 1] : null;
const nextDoc = currentIndex < docsData.length - 1 ? docsData[currentIndex + 1] : null;
---

<BaseLayout title={doc.title} description={doc.description ?? doc.content} wide>
  <div class="lg:flex lg:items-start lg:gap-14">
    <Sidebar selectedDocId={doc.id} />

    <article class="min-w-0 flex-1">
      <p class="text-xs text-gray-400 mb-5">
        <a href="/docs" class="text-gray-500 no-underline hover:text-[#0f6b4f] font-semibold">Docs</a>
        <span class="mx-1.5">/</span>
        <span class="text-gray-500">{doc.category}</span>
      </p>

      <DocContent section={doc} />

      <nav class="flex justify-between gap-4 text-sm mt-14 pt-6 border-t border-gray-100">
        <span class="min-w-0">
          {prevDoc && (
            <a href={`/docs/${prevDoc.id}`} class="text-gray-600 no-underline hover:text-[#0f6b4f] font-medium">
              <span class="text-gray-400">←</span> {prevDoc.title.replace(/^\d+(\.\d+)?\s+/, "")}
            </a>
          )}
        </span>
        <span class="min-w-0 text-right">
          {nextDoc && (
            <a href={`/docs/${nextDoc.id}`} class="text-gray-600 no-underline hover:text-[#0f6b4f] font-medium">
              {nextDoc.title.replace(/^\d+(\.\d+)?\s+/, "")} <span class="text-gray-400">→</span>
            </a>
          )}
        </span>
      </nav>
    </article>
  </div>
</BaseLayout>
