---
import BaseLayout from "../../layouts/BaseLayout.astro";
import MarkdownBody from "../../components/MarkdownBody.astro";
import { stdlib } from "../../lib/stdlibDocs";

const groups = stdlib.guides.reduce((acc: Record<string, typeof stdlib.guides>, page) => {
  (acc[page.group] ??= []).push(page);
  return acc;
}, {});
---

<BaseLayout
  title="Standard Library"
  description="Reference for Dryad's @std standard library: buffers, text, collections, I/O, async, threading, and networking."
  wide
>
  <h1 class="text-2xl md:text-3xl font-extrabold text-gray-900 mb-2 tracking-tight">Standard Library</h1>
  <p class="text-[15px] text-gray-600 mb-10 leading-relaxed max-w-[64ch]">
    <code>@std</code> is written in Dryad on top of runtime intrinsics. Every guide below is maintained in
    <a href="https://github.com/dryadlang/docs/tree/main/stdlib">docs/stdlib</a>; the
    <a href="/coverage">coverage map</a> tracks which APIs are documented and tested.
  </p>

  <div class="grid sm:grid-cols-2 gap-x-10 gap-y-10 mb-14">
    {Object.entries(groups).map(([group, guides]) => (
      <div>
        <p class="eyebrow mb-3">{group}</p>
        <div class="flex flex-col">
          {guides.map((page) => (
            <a href={`/stdlib/${page.slug}`} class="group block no-underline py-2.5 border-b border-gray-100">
              <h3 class="text-[15px] font-semibold text-gray-900 group-hover:text-[#0f6b4f] transition-colors">
                <code class="text-[14px]">{page.title}</code>
                {page.coverage && (
                  <span class="ml-2 text-[11px] font-normal text-gray-400">
                    {page.coverage.documented}/{page.coverage.apis} documented
                  </span>
                )}
              </h3>
              <p class="text-[13px] text-gray-500 mt-0.5 leading-relaxed line-clamp-2">{page.summary}</p>
            </a>
          ))}
        </div>
      </div>
    ))}
  </div>

  {stdlib.index && (
    <section class="max-w-[72ch]">
      <p class="eyebrow mb-4">Overview</p>
      <MarkdownBody html={stdlib.index.html} />
    </section>
  )}
</BaseLayout>
