---
import BaseLayout from '../layouts/BaseLayout.astro';
import { blogData } from '../data/blogData';
---

<BaseLayout title="Blog" description="Technical articles from Dryad's compiler team — architecture decisions, execution models, memory safety, and language design. No fluff or hype.">
  <div>
    <h2 class="text-lg font-bold text-gray-900 mb-1 leading-tight">Dryad DevLog</h2>
    <p class="text-sm text-gray-600 mb-8 leading-relaxed">
      Follow the architectural decisions from Dryad's compiler team and runtime engineers.
      Technical articles with no fluff or hype.
    </p>

    <div class="flex flex-col gap-8">
      {blogData.map((article) => (
        <article>
          <p class="text-xs text-gray-500 mb-1">
            {article.date} · {article.author} · {article.readTime}
          </p>

          <a href={`/blog/${article.id}`} class="no-underline">
            <h3 class="text-base font-bold text-gray-900 mb-2 hover:underline leading-snug">
              {article.title}
            </h3>
          </a>

          <p class="text-sm text-gray-600 mb-2 leading-relaxed">{article.summary}</p>

          <p class="text-xs text-gray-500">
            {article.tags.map((tag, i) => (
              <span>{i > 0 && <span class="text-gray-300 mx-0.5">·</span>}<span>{tag}</span></span>
            ))}
          </p>
        </article>
      ))}
    </div>
  </div>
</BaseLayout>
