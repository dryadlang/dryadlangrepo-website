---
import BaseLayout from '../layouts/BaseLayout.astro';
import { blogData } from '../data/blogData';
---

<BaseLayout title="Blog" currentTab="blog">
  <div class="max-w-4xl mx-auto animate-fadeIn">
    <div class="py-4 mb-6 border-b border-gray-150">
      <h2 class="text-gray-900 font-extrabold text-sm md:text-base uppercase tracking-wider mb-2 flex items-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-emerald-800"><rect width="20" height="14" x="2" y="3" rx="2"/><line x1="8" x2="16" y1="21" y2="21"/><line x1="12" x2="12" y1="17" y2="21"/></svg>
        Dryad DevLog & Análises Técnicas
      </h2>
      <p class="text-xs text-gray-650 font-sans leading-relaxed">
        Acompanhe as decisões arquiteturais da equipe de compiladores e engenheiros de runtime da linguagem Dryad. Artigos técnicos sem decorações vazias ou marketing exagerado.
      </p>
    </div>

    <div class="flex flex-col gap-6">
      {blogData.map((article) => (
        <article class="py-6 border-b border-gray-150 last:border-0 hover:bg-emerald-50/10 transition-colors">
          <div class="flex items-center gap-3 text-[11px] text-gray-500 font-bold mb-2.5">
            <span class="flex items-center gap-1">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-gray-400"><path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/></svg>
              {article.date}
            </span>
            <span>•</span>
            <span class="flex items-center gap-1">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-gray-400"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
              {article.author}
            </span>
            <span>•</span>
            <span class="flex items-center gap-1 text-emerald-700">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-emerald-600"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
              {article.readTime}
            </span>
          </div>

          <a href={`/blog/${article.id}`} class="no-underline">
            <h3 class="text-gray-900 font-bold text-base md:text-lg mb-3 hover:underline cursor-pointer select-all leading-snug">
              {article.title}
            </h3>
          </a>

          <p class="text-xs md:text-xs.5 text-gray-600 font-sans font-medium mb-4 leading-relaxed">
            {article.summary}
          </p>

          <div class="flex flex-wrap gap-1.5 items-center justify-between mt-4 border-t border-gray-150 pt-3">
            <div class="flex gap-1.5">
              {article.tags.map((tag) => (
                <span class="text-[9px] font-bold text-gray-500 bg-gray-50 border border-gray-200 px-1.5 py-0.5 uppercase">
                  {tag}
                </span>
              ))}
            </div>

            <a
              href={`/blog/${article.id}`}
              class="text-emerald-700 hover:text-emerald-600 font-bold text-xs flex items-center gap-1 no-underline"
            >
              Ler Artigo Completo
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</BaseLayout>
