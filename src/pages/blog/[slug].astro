---
import { marked } from "marked";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { blogData } from "../../data/blogData";

export async function getStaticPaths() {
  return blogData.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const renderedContent = marked.parse(article.content.join("\n\n"));
---

<BaseLayout
  title={article.title}
  description={article.description ?? article.summary}
  type="article"
>
  <article>
    <p class="text-xs text-gray-400 mb-6">
      <a href="/blog" class="text-[#0f6b4f] no-underline hover:underline font-semibold"
        >← Back to DevLog</a
      >
    </p>

    <p class="eyebrow mb-3">{article.date} · By {article.author} · {article.readTime}</p>

    <h1 class="text-2xl md:text-3xl font-extrabold text-gray-900 mb-8 tracking-tight leading-tight max-w-[22ch]">{article.title}</h1>

    <div
      class="blog-content flex flex-col text-[15px] md:text-base text-gray-700 leading-relaxed mb-10 max-w-[64ch]"
      set:html={renderedContent}
    />

    <p class="text-xs text-gray-400 pt-6 border-t border-gray-100">
      {article.tags.map((tag, i) => (
        <span
          >{i > 0 && <span class="text-gray-300 mx-1.5">·</span>}<span>{tag}</span></span
        >
      ))}
    </p>
  </article>
</BaseLayout>

<style>
  .blog-content > :first-child {
    margin-top: 0;
  }
  .blog-content h2 {
    font-size: 1.25rem;
    font-weight: 800;
    color: #111827;
    letter-spacing: -0.01em;
    margin: 1.75em 0 0.6em 0;
    line-height: 1.35;
  }
  .blog-content h3 {
    font-size: 1.05rem;
    font-weight: 700;
    color: #111827;
    margin: 1.4em 0 0.5em 0;
    line-height: 1.4;
  }
  .blog-content hr {
    border: none;
    border-top: 1px solid #e5e7eb;
    margin: 1.5em 0;
  }
  .blog-content p {
    margin-bottom: 0.7em;
    line-height: 1.7;
  }
  .blog-content p:last-child {
    margin-bottom: 0;
  }
  .blog-content pre {
    font-family: "JetBrains Mono", "Fira Code", "Cascadia Code", "Consolas", monospace;
    font-size: 0.8125rem;
    line-height: 1.6;
    background: #13161a;
    color: #e2e8f0;
    border: none;
    border-left: 3px solid #0f6b4f;
    border-radius: 0;
    padding: 1em 1.125em;
    margin: 0.75em 0;
    overflow-x: auto;
    white-space: pre;
  }
  .blog-content code {
    font-family: "JetBrains Mono", "Fira Code", "Cascadia Code", "Consolas", monospace;
    font-size: 0.8125rem;
    background: #f1f5f9;
    padding: 0.1em 0.3em;
    border-radius: 2px;
    color: #0f6b4f;
  }
  .blog-content pre code {
    background: none;
    padding: 0;
    border-radius: 0;
    font-size: inherit;
  }
  .blog-content ul,
  .blog-content ol {
    padding-left: 1.5em;
    margin: 0.5em 0;
  }
  .blog-content li {
    margin-bottom: 0.3em;
    line-height: 1.6;
  }
  .blog-content strong {
    font-weight: 700;
    color: #111827;
  }
  .blog-content em {
    font-style: italic;
  }
  .blog-content blockquote {
    border-left: 3px solid #0f6b4f;
    padding: 0.5em 1em;
    margin: 0.6em 0;
    background: #f7faf9;
    color: #374151;
    font-style: italic;
  }
  .blog-content a {
    color: #0f6b4f;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .blog-content a:hover {
    color: #0b543d;
  }
</style>
