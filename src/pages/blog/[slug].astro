---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { blogData } from '../../data/blogData';

export async function getStaticPaths() {
  return blogData.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
---

<BaseLayout
  title={article.title}
  description={article.description ?? article.summary}
  type="article"
>
  <article class="py-2">
    <p class="text-xs text-gray-500 mb-4">
      <a href="/blog" class="text-emerald-800 no-underline hover:underline font-semibold">← Back to DevLog</a>
    </p>

    <p class="text-xs text-gray-500 mb-2">{article.date} · By {article.author} · {article.readTime}</p>

    <h1 class="text-lg font-bold text-gray-900 mb-6 leading-tight">{article.title}</h1>

    <div class="flex flex-col gap-4 text-sm text-gray-700 leading-relaxed mb-8">
      {article.content.map((paragraph) => (
        <p class="leading-relaxed">{paragraph}</p>
      ))}
    </div>

    <p class="text-xs text-gray-500">
      {article.tags.map((tag, i) => (
        <span>{i > 0 && <span class="text-gray-300 mx-0.5">·</span>}<span>{tag}</span></span>
      ))}
    </p>
  </article>
</BaseLayout>
